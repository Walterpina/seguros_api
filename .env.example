# Lending Insurance Quotation System - Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/seguros_api

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# API Configuration
API_TITLE=Lending Insurance Quotation API
API_VERSION=1.0.0
LOG_LEVEL=INFO

# Premium & Brokerage (default rates)
DEFAULT_PREMIUM_RATE=0.045
DEFAULT_BROKERAGE_RATE=0.15

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Redis (Cache)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_MINUTES=5

# Environment
ENVIRONMENT=development
