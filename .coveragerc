[run]
branch = True
source = src
omit =
    */tests/*
    */test_*.py
    */__init__.py
    */migrations/*
    */alembic/*

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    @abstractmethod
    @abstractproperty
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    @overload

[html]
directory = htmlcov

[xml]
output = coverage.xml

[paths]
source =
    src
    */site-packages
